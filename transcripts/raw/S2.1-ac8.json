, 356, 423, 1909, 13, 50893], "temperature": 0.0, "avg_logprob": -0.14103815772316672, "compression_ratio": 1.4324324324324325, "no_speech_prob": 0.006557863671332598}, {"id": 77, "seek": 23252, "start": 243.12, "end": 246.60000000000002, "text": " Blockchain, that's how it works.", "tokens": [50893, 29724, 11, 326, 338, 703, 340, 2499, 13, 51067], "temperature": 0.0, "avg_logprob": -0.14103815772316672, "compression_ratio": 1.4324324324324325, "no_speech_prob": 0.006557863671332598}], "language": "English"}