": -0.12256772414497707, "compression_ratio": 1.6789667896678966, "no_speech_prob": 0.006373276934027672}, {"id": 39, "seek": 11420, "start": 114.2, "end": 116.88000000000001, "text": " Each one of these new worlds invites a comparison", "tokens": [50363, 5501, 530, 286, 777, 649, 11621, 27671, 257, 7208, 50497], "temperature": 0.0, "avg_logprob": -0.11260351045863835, "compression_ratio": 1.6442953020134228, "no_speech_prob": 0.008954319171607494}, {"id": 40, "seek": 11420, "start": 116.88000000000001, "end": 120.48, "text": " between the newly discovered planet and the planets we know best,", "tokens": [50497, 1022, 262, 8308, 5071, 5440, 290, 262, 14705, 356, 760, 1266, 11, 50677], "temperature": 0.0, "avg_logprob": -0.11260351045863835, "compression_ratio": 1.6442953020134228, "no_speech_prob": 0.008954319171607494}, {"id": 41, "seek": 11420, "start": 120.48, "end": 122.52000000000001, "text": " those of our own solar system.", "tokens": [50677, 883, 286, 674, 898, 6591, 1080, 13, 50779], "temperature": 0.0, "avg_logprob": -0.11260351045863835, "compression_ratio": 1.6442953020134228, "no_speech_prob": 0.008954319171607494}, {"id": 42, "seek": 11420, "start": 122.52000000000001, "end": 124.48, "text": " Consider our neighbour, Mars.", "tokens": [50779, 12642, 674, 12250, 11, 8706, 13, 50877], "temperature": 0.0, "avg_logprob": -0.11260351045863835, "compression_ratio": 1.6442953020134228, "no_speech_prob": 0.008954319171607494}, {"id": 43, "seek": 11420, "start": 124.48, "end": 128.24, "text": " Mars is small and rocky, and though it's a bit far from the sun,", "tokens": [50877, 8706, 318, 1402, 290, 26898, 11, 290, 996, 340, 338, 257, 1643, 1290, 422, 262, 4252, 11, 51065], "temperature": 0.0, "avg_logprob": -0.11260351045863835, "compression_ratio": 1.6442953020134228, "no_speech_prob": 0.008954319171607494}, {"id": 44, "seek": 11420, "start": 128.24, "end": 130.76, "text": " it might be considered a potentially habitable world", "tokens": [51065, 340, 1244, 307, 3177, 257, 6196, 49055, 995, 51191], "temperature": 0.0, "avg_logprob": -0.11260351045863835, "compression_ratio": 1.6442953020134228, "no_speech_prob": 0.008954319171607494}, {"id": 45, "seek": 11420, "start": 130.76, "end": 132.88, "text": " if found by a mission like Kepler.", "tokens": [51191, 611, 1043, 416, 257, 4365, 588, 40294, 13, 51297], "temperature": 0.0, "avg_logprob": -0.11260351045863835, "compression_ratio": 1.6442953020134228, "no_speech_prob": 0.008954319171607494}, {"id": 46, "seek": 11420, "start": 132.88, "end": 136.32, "text": " Indeed, it's possible that Mars was habitable in the past.", "tokens": [51297, 9676, 11, 340, 338, 1744, 326, 8706, 373, 49055, 287, 262, 1613, 13, 51469], "temperature": 0.0, "avg_logprob": -0.11260351045863835, "compression_ratio": 1.6442953020134228, "no_speech_prob": 0.008954319171607494}, {"id": 47, "seek": 11420, "start": 136.32, "end": 139.6, "text": " And in part, this is why we study Mars so much.", "tokens": [51469, 843, 287, 636, 11, 428, 318, 1521, 356, 2050, 8706, 523, 881, 13, 51633], "temperature": 0.0, "avg_logprob": -0.11260351045863835, "compression_ratio": 1.6442953020134228, "no_speech_prob": 0.008954319171607494}, {"id": 48, "seek": 11420, "start": 139.6, "end": 142.92000000000002, "text": " Our rovers, like Curiosity, crawl across its surface,", "tokens": [51633, 3954, 686, 690, 11, 588, 39736, 11, 27318, 1973, 663, 4417, 11, 51799], "temperature": 0.0, "avg_logprob": -0.11260351045863835, "compression_ratio": 1.6442953020134228, "no_speech_prob": 0.008954319171607494}, {"id": 49, "seek": 14292, "start": 142.92, "end": 146.35999999999999, "text": " scratching for clues as to the origins of life as we know it.", "tokens": [50363, 34688, 329, 20195, 355, 284, 262, 15587, 286, 1204, 355, 356, 760, 340, 13, 50535], "temperature": 0.0, "avg_logprob": -0.12540318225992136, "compression_ratio": 1.6409395973154361, "no_speech_prob": 0.02130347117781639}, {"id": 50, "seek": 14292, "start": 146.35999999999999, "end": 149.67999999999998, "text": " Orbiters like the MAVEN mission sample the Martian atmosphere,", "tokens": [50535, 38161, 364, 588, 262, 8779, 28290, 4365, 6291, 262, 32508, 8137, 11, 50701], "temperature": 0.0, "avg_logprob": -0.12540318225992136, "compression_ratio": 1.6409395973154361, "no_speech_prob": 0.02130347117781639}, {"id": 51, "seek": 14292, "start": 149.67999999999998, "end": 153.6, "text": " trying to understand how Mars might have lost its past habitability.", "tokens": [50701, 2111, 284, 1833, 703, 8706, 1244, 423, 2626, 663, 1613, 7947, 1799, 13, 50897], "temperature": 0.0, "avg_logprob": -0.12540318225992136, "compression_ratio": 1.6409395973154361, "no_speech_prob": 0.02130347117781639}, {"id": 52, "seek": 14292, "start": 153.6, "end": 156.0, "text": " Private space flight companies now offer", "tokens": [50897, 15348, 2272, 5474, 2706, 783, 2897, 51017], "temperature": 0.0, "avg_logprob": -0.12540318225992136, "compression_ratio": 1.6409395973154361, "no_speech_prob": 0.02130347117781639}, {"id": 53, "seek": 14292, "start": 156.0, "end": 157.95999999999998, "text": " not just a short trip to near space,", "tokens": [51017, 407, 655, 257, 1790, 5296, 284, 1474, 2272, 11, 51115], "temperature": 0.0, "avg_logprob": -0.12540318225992136, "compression_ratio": 1.6409395973154361, "no_speech_prob": 0.02130347117781639}, {"id": 54, "seek": 14292, "start": 157.95999999999998, "end": 162.16, "text": " but the tantalizing possibility of living our lives on Mars.", "tokens": [51115, 475, 262, 46937, 2890, 5885, 286, 2877, 674, 3160, 319, 8706, 13, 51325], "temperature": 0.0, "avg_logprob": -0.12540318225992136, "compression_ratio": 1.6409395973154361, "no_speech_prob": 0.02130347117781639}, {"id": 55, "seek": 14292, "start": 162.16, "end": 166.2, "text": " But though these Martian vistas resemble the deserts of our own home world,", "tokens": [51325, 887, 996, 777, 32508, 410, 37503, 22464, 262, 45288, 286, 674, 898, 1363, 995, 11, 51527], "temperature": 0.0, "avg_logprob": -0.12540318225992136, "compression_ratio": 1.6409395973154361, "no_speech_prob": 0.02130347117781639}, {"id": 56, "seek": 14292, "start": 166.2, "end": 168.23999999999998, "text": " places that are tied in our imagination", "tokens": [51527, 4113, 326, 389, 8165, 287, 674, 13843, 51629], "temperature": 0.0, "avg_logprob": -0.12540318225992136, "compression_ratio": 1.6409395973154361, "no_speech_prob": 0.02130347117781639}, {"id": 57, "seek": 14292, "start": 168.23999999999998, "end": 172.04, "text": " to ideas about pioneering and frontiers,", "tokens": [51629, 284, 4213, 546, 36304, 290, 2166, 3183, 11, 51819], "temperature": 0.0, "avg_logprob": -0.12540318225992136, "compression_ratio": 1.6409395973154361, "no_speech_prob": 0.02130347117781639}, {"id": 58, "seek": 17204, "start": 172.04, "end": 176.84, "text": " compared to Earth, Mars is a pretty terrible place to live.", "tokens": [50363, 3688, 284, 3668, 11, 8706, 318, 257, 2495, 7818, 1295, 284, 2107, 13, 50603], "temperature": 0.0, "avg_logprob": -0.11561236871737186, "compression_ratio": 1.6612244897959183, "no_speech_prob": 0.003816466312855482}, {"id": 59, "seek": 17204, "start": 176.84, "end": 180.04, "text": " Consider the extent to which we have not colonized", "tokens": [50603, 12642, 262, 6287, 284, 543, 356, 423, 407, 7633, 1143, 50763], "temperature": 0.0, "avg_logprob": -0.11561236871737186, "compression_ratio": 1.6612244897959183, "no_speech_prob": 0.003816466312855482}, {"id": 60, "seek": 17204, "start": 180.04, "end": 181.92, "text": " the deserts of our own planet,", "tokens": [50763, 262, 45288, 286, 674, 898, 5440, 11, 50857], "temperature": 0.0, "avg_logprob": -0.11561236871737186, "compression_ratio": 1.6612244897959183, "no_speech_prob": 0.003816466312855482}, {"id": 61, "seek": 17204, "start": 181.92, "end": 184.88, "text": " places that are lush by comparison with Mars.", "tokens": [50857, 4113, 326, 389, 37408, 416, 7208, 351, 8706, 13, 51005], "temperature": 0.0, "avg_logprob": -0.11561236871737186, "compression_ratio": 1.6612244897959183, "no_speech_prob": 0.003816466312855482}, {"id": 62, "seek": 17204, "start": 184.88, "end": 187.72, "text": " Even in the driest, highest places on Earth,", "tokens": [51005, 3412, 287, 262, 1454, 395, 11, 4511, 4113, 319, 3668, 11, 51147], "temperature": 0.0, "avg_logprob": -0.11561236871737186, "compression_ratio": 1.6612244897959183, "no_speech_prob": 0.003816466312855482}, {"id": 63, "seek": 17204, "start": 187.72, "end": 190.12, "text": " the air is sweet and thick with oxygen,", "tokens": [51147, 262, 1633, 318, 6029, 290, 6546, 351, 11863, 11, 51267], "temperature": 0.0, "avg_logprob": -0.11561236871737186, "compression_ratio": 1.6612244897959183, "no_speech_prob": 0.003816466312855482}, {"id": 64, "seek": 17204, "start": 190.12, "end": 194.84, "text": " exhaled from thousands of miles away by our rainforests.", "tokens": [51267, 21847, 3021, 422, 4138, 286, 4608, 1497, 416, 674, 6290, 754, 6448, 13, 51503], "temperature": 0.0, "avg_logprob": -0.11561236871737186, "compression_ratio": 1.6612244897959183, "no_speech_prob": 0.003816466312855482}, {"id": 65, "seek": 17204, "start": 194.84, "end": 195.84, "text": " I worry.", "tokens": [51503, 314, 5490, 13, 51553], "temperature": 0.0, "avg_logprob": -0.11561236871737186, "compression_ratio": 1.6612244897959183, "no_speech_prob": 0.003816466312855482}, {"id": 66, "seek": 17204, "start": 195.84, "end": 200.79999999999998, "text": " I worry that this excitement about colonizing Mars and other planets", "tokens": [51553, 314, 5490, 326, 428, 14067, 546, 7633, 2890, 8706, 290, 584, 14705, 51801], "temperature": 0.0, "avg_logprob": -0.11561236871737186, "compression_ratio": 1.6612244897959183, "no_speech_prob": 0.003816466312855482}, {"id": 67, "seek": 20080, "start": 200.8, "end": 203.28, "text": " carries with it a long, dark shadow,", "tokens": [50363, 10732, 351, 340, 257, 890, 11, 3223, 9082, 11, 50487], "temperature": 0.0, "avg_logprob": -0.10969706624746323, "compression_ratio": 1.7167235494880546, "no_speech_prob": 0.009929470717906952}, {"id": 68, "seek": 20080, "start": 203.28, "end": 205.56, "text": " the implication and belief by some", "tokens": [50487, 262, 26863, 290, 4901, 416, 617, 50601], "temperature": 0.0, "avg_logprob": -0.10969706624746323, "compression_ratio": 1.7167235494880546, "no_speech_prob": 0.009929470717906952}, {"id": 69, "seek": 20080, "start": 205.56, "end": 208.96, "text": " that Mars will be there to save us from the self-inflicted destruction", "tokens": [50601, 326, 8706, 481, 307, 612, 284, 3613, 514, 422, 262, 2116, 12, 10745, 17823, 8166, 50771], "temperature": 0.0, "avg_logprob": -0.10969706624746323, "compression_ratio": 1.7167235494880546, "no_speech_prob": 0.009929470717906952}, {"id": 70, "seek": 20080, "start": 208.96, "end": 213.12, "text": " of the only truly habitable planet we know of, the Earth.", "tokens": [50771, 286, 262, 691, 4988, 49055, 5440, 356, 760, 286, 11, 262, 3668, 13, 50979], "temperature": 0.0, "avg_logprob": -0.10969706624746323, "compression_ratio": 1.7167235494880546, "no_speech_prob": 0.009929470717906952}, {"id": 71, "seek": 20080, "start": 213.12, "end": 215.4, "text": " As much as I love interplanetary exploration,", "tokens": [50979, 1081, 881, 355, 314, 1842, 987, 11578, 8527, 13936, 11, 51093], "temperature": 0.0, "avg_logprob": -0.10969706624746323, "compression_ratio": 1.7167235494880546, "no_speech_prob": 0.009929470717906952}, {"id": 72, "seek": 20080, "start": 215.4, "end": 217.8, "text": " I deeply disagree with this idea.", "tokens": [51093, 314, 7744, 12546, 351, 428, 2126, 13, 51213], "temperature": 0.0, "avg_logprob": -0.10969706624746323, "compression_ratio": 1.7167235494880546, "no_speech_prob": 0.009929470717906952}, {"id": 73, "seek": 20080, "start": 217.8, "end": 220.44, "text": " There are many excellent reasons to go to Mars,", "tokens": [51213, 1318, 389, 867, 6275, 3840, 284, 467, 284, 8706, 11, 51345], "temperature": 0.0, "avg_logprob": -0.10969706624746323, "compression_ratio": 1.7167235494880546, "no_speech_prob": 0.009929470717906952}, {"id": 74, "seek": 20080, "start": 220.44, "end": 224.04000000000002, "text": " but for anyone to tell you that Mars will be there to back up humanity", "tokens": [51345, 475, 329, 2687, 284, 1560, 345, 326, 8706, 481, 307, 612, 284, 736, 510, 9265, 51525], "temperature": 0.0, "avg_logprob": -0.10969706624746323, "compression_ratio": 1.7167235494880546, "no_speech_prob": 0.009929470717906952}, {"id": 75, "seek": 20080, "start": 224.04000000000002, "end": 225.68, "text": " is like the captain of the Titanic", "tokens": [51525, 318, 588, 262, 10654, 286, 262, 41184, 51607], "temperature": 0.0, "avg_logprob": -0.10969706624746323, "compression_ratio": 1.7167235494880546, "no_speech_prob": 0.009929470717906952}, {"id": 76, "seek": 20080, "start": 225.68, "end": 229.0, "text": " telling you that the real party is happening later on the lifeboats.", "tokens": [51607, 5149, 345, 326, 262, 1103, 2151, 318, 5836, 1568, 319, 262, 1204, 46058, 13, 51773], "temperature": 0.0, "avg_logprob": -0.10969706624746323, "compression_ratio": 1.7167235494880546, "no_speech_prob": 0.009929470717906952}, {"id": 77, "seek": 22900, "start": 229.0, "end": 231.0, "text": " LAUGHTER", "tokens": [50363, 9131, 44004, 5781, 50463], "temperature": 0.0, "avg_logprob": -0.24332947981984993, "compression_ratio": 1.5158371040723981, "no_speech_prob": 0.02813248336315155}, {"id": 78, "seek": 22900, "start": 231.0, "end": 235.0, "text": " APPLAUSE", "tokens": [50463, 3486, 45710, 19108, 50663], "temperature": 0.0, "avg_logprob": -0.24332947981984993, "compression_ratio": 1.5158371040723981, "no_speech_prob": 0.02813248336315155}, {"id": 79, "seek": 22900, "start": 235.0, "end": 236.0, "text": " Thank you.", "tokens": [50663, 6952, 345, 13, 50713], "temperature": 0.0, "avg_logprob": -0.24332947981984993, "compression_ratio": 1.5158371040723981, "no_speech_prob": 0.02813248336315155}, {"id": 80, "seek": 22900, "start": 236.0, "end": 238.0, "text": " APPLAUSE", "tokens": [50713, 3486, 45710, 19108, 50813], "temperature": 0.0, "avg_logprob": -0.24332947981984993, "compression_ratio": 1.5158371040723981, "no_speech_prob": 0.02813248336315155}, {"id": 81, "seek": 22900, "start": 238.0, "end": 242.08, "text": " But the goals of interplanetary exploration and planetary preservation", "tokens": [50813, 887, 262, 4661, 286, 987, 11578, 8527, 13936, 290, 27047, 22459, 51017], "temperature": 0.0, "avg_logprob": -0.24332947981984993, "compression_ratio": 1.5158371040723981, "no_speech_prob": 0.02813248336315155}, {"id": 82, "seek": 22900, "start": 242.08, "end": 243.84, "text": " are not opposed to one another.", "tokens": [51017, 389, 407, 6886, 284, 530, 1194, 13, 51105], "temperature": 0.0, "avg_logprob": -0.24332947981984993, "compression_ratio": 1.5158371040723981, "no_speech_prob": 0.02813248336315155}, {"id": 83, "seek": 22900, "start": 243.84, "end": 246.64, "text": " No, they're in fact two sides of the same goal,", "tokens": [51105, 1400, 11, 484, 821, 287, 1109, 734, 5389, 286, 262, 976, 3061, 11, 51245], "temperature": 0.0, "avg_logprob": -0.24332947981984993, "compression_ratio": 1.5158371040723981, "no_speech_prob": 0.02813248336315155}, {"id": 84, "seek": 22900, "start": 246.64, "end": 250.8, "text": " to understand, preserve and improve life into the future.", "tokens": [51245, 284, 1833, 11, 12201, 290, 2987, 1204, 656, 262, 2003, 13, 51453], "temperature": 0.0, "avg_logprob": -0.24332947981984993, "compression_ratio": 1.5158371040723981, "no_speech_prob": 0.02813248336315155}, {"id": 85, "seek": 22900, "start": 250.8, "end": 254.88, "text": " The extreme environments of our own world are alien vistas.", "tokens": [51453, 383, 3257, 12493, 286, 674, 898, 995, 389, 8756, 410, 37503, 13, 51657], "temperature": 0.0, "avg_logprob": -0.24332947981984993, "compression_ratio": 1.5158371040723981, "no_speech_prob": 0.02813248336315155}, {"id": 86, "seek": 22900, "start": 254.88, "end": 256.84, "text": " They're just closer to home.", "tokens": [51657, 1119, 821, 655, 5699, 284, 1363, 13, 51755], "temperature": 0.0, "avg_logprob": -0.24332947981984993, "compression_ratio": 1.5158371040723981, "no_speech_prob": 0.02813248336315155}, {"id": 87, "seek": 25684, "start": 256.84, "end": 261.23999999999995, "text": " If we can understand how to create and maintain habitable spaces", "tokens": [50363, 1002, 356, 460, 1833, 703, 284, 2251, 290, 5529, 49055, 9029, 50583], "temperature": 0.0, "avg_logprob": -0.13195805845007433, "compression_ratio": 1.6277372262773722, "no_speech_prob": 0.018649503588676453}, {"id": 88, "seek": 25684, "start": 261.23999999999995, "end": 264.52, "text": " out of hostile, inhospitable spaces here on Earth,", "tokens": [50583, 503, 286, 12524, 11, 25783, 2117, 4674, 9029, 994, 319, 3668, 11, 50747], "temperature": 0.0, "avg_logprob": -0.13195805845007433, "compression_ratio": 1.6277372262773722, "no_speech_prob": 0.018649503588676453}, {"id": 89, "seek": 25684, "start": 264.52, "end": 267.76, "text": " perhaps we can meet the needs of both preserving our own environment", "tokens": [50747, 3737, 356, 460, 1826, 262, 2476, 286, 1111, 23934, 674, 898, 2858, 50909], "temperature": 0.0, "avg_logprob": -0.13195805845007433, "compression_ratio": 1.6277372262773722, "no_speech_prob": 0.018649503588676453}, {"id": 90, "seek": 25684, "start": 267.76, "end": 270.0, "text": " and moving beyond it.", "tokens": [50909, 290, 3867, 3675, 340, 13, 51021], "temperature": 0.0, "avg_logprob": -0.13195805845007433, "compression_ratio": 1.6277372262773722, "no_speech_prob": 0.018649503588676453}, {"id": 91, "seek": 25684, "start": 270.0, "end": 274.12, "text": " I leave you with a final thought experiment, Fermi's Paradox.", "tokens": [51021, 314, 2666, 345, 351, 257, 2457, 1807, 6306, 11, 376, 7780, 72, 338, 37983, 13, 51227], "temperature": 0.0, "avg_logprob": -0.13195805845007433, "compression_ratio": 1.6277372262773722, "no_speech_prob": 0.018649503588676453}, {"id": 92, "seek": 25684, "start": 274.12, "end": 278.08, "text": " Many years ago, the physicist Enrico Fermi asked that,", "tokens": [51227, 4650, 812, 2084, 11, 262, 33013, 2039, 1173, 78, 376, 7780, 72, 1965, 326, 11, 51425], "temperature": 0.0, "avg_logprob": -0.13195805845007433, "compression_ratio": 1.6277372262773722, "no_speech_prob": 0.018649503588676453}, {"id": 93, "seek": 25684, "start": 278.08, "end": 281.76, "text": " given the fact that our universe has been around for a very long time", "tokens": [51425, 1813, 262, 1109, 326, 674, 6881, 468, 587, 1088, 329, 257, 845, 890, 640, 51609], "temperature": 0.0, "avg_logprob": -0.13195805845007433, "compression_ratio": 1.6277372262773722, "no_speech_prob": 0.018649503588676453}, {"id": 94, "seek": 25684, "start": 281.76, "end": 284.55999999999995, "text": " and we expect that there are many planets within it,", "tokens": [51609, 290, 356, 1607, 326, 612, 389, 867, 14705, 1626, 340, 11, 51749], "temperature": 0.0, "avg_logprob": -0.13195805845007433, "compression_ratio": 1.6277372262773722, "no_speech_prob": 0.018649503588676453}, {"id": 95, "seek": 28456, "start": 284.56, "end": 287.76, "text": " we should have found evidence for alien life by now.", "tokens": [50363, 356, 815, 423, 1043, 2370, 329, 8756, 1204, 416, 783, 13, 50523], "temperature": 0.0, "avg_logprob": -0.11520026711856618, "compression_ratio": 1.5719557195571956, "no_speech_prob": 0.005739470478147268}, {"id": 96, "seek": 28456, "start": 287.76, "end": 289.56, "text": " So where are they?", "tokens": [50523, 1406, 810, 389, 484, 30, 50613], "temperature": 0.0, "avg_logprob": -0.11520026711856618, "compression_ratio": 1.5719557195571956, "no_speech_prob": 0.005739470478147268}, {"id": 97, "seek": 28456, "start": 289.56, "end": 293.0, "text": " Well, one possible solution to Fermi's Paradox", "tokens": [50613, 3894, 11, 530, 1744, 4610, 284, 376, 7780, 72, 338, 37983, 50785], "temperature": 0.0, "avg_logprob": -0.11520026711856618, "compression_ratio": 1.5719557195571956, "no_speech_prob": 0.005739470478147268}, {"id": 98, "seek": 28456, "start": 293.0, "end": 296.52, "text": " is that as civilizations become technologically advanced enough", "tokens": [50785, 318, 326, 355, 35928, 1716, 48299, 6190, 1576, 50961], "temperature": 0.0, "avg_logprob": -0.11520026711856618, "compression_ratio": 1.5719557195571956, "no_speech_prob": 0.005739470478147268}, {"id": 99, "seek": 28456, "start": 296.52, "end": 298.92, "text": " to consider living amongst the stars,", "tokens": [50961, 284, 2074, 2877, 12077, 262, 5788, 11, 51081], "temperature": 0.0, "avg_logprob": -0.11520026711856618, "compression_ratio": 1.5719557195571956, "no_speech_prob": 0.005739470478147268}, {"id": 100, "seek": 28456, "start": 298.92, "end": 301.4, "text": " they lose sight of how important it is", "tokens": [51081, 484, 4425, 6504, 286, 703, 1593, 340, 318, 51205], "temperature": 0.0, "avg_logprob": -0.11520026711856618, "compression_ratio": 1.5719557195571956, "no_speech_prob": 0.005739470478147268}, {"id": 101, "seek": 28456, "start": 301.4, "end": 306.16, "text": " to safeguard the home worlds that fostered that advancement to begin with.", "tokens": [51205, 284, 30925, 262, 1363, 11621, 326, 26546, 1068, 326, 27647, 284, 2221, 351, 13, 51443], "temperature": 0.0, "avg_logprob": -0.11520026711856618, "compression_ratio": 1.5719557195571956, "no_speech_prob": 0.005739470478147268}, {"id": 102, "seek": 28456, "start": 306.16, "end": 307.84000000000003, "text": " It is hubris to believe", "tokens": [51443, 632, 318, 12575, 2442, 284, 1975, 51527], "temperature": 0.0, "avg_logprob": -0.11520026711856618, "compression_ratio": 1.5719557195571956, "no_speech_prob": 0.005739470478147268}, {"id": 103, "seek": 28456, "start": 307.84000000000003, "end": 311.96, "text": " that interplanetary colonization alone will save us from ourselves,", "tokens": [51527, 326, 987, 11578, 8527, 40337, 3436, 481, 3613, 514, 422, 6731, 11, 51733], "temperature": 0.0, "avg_logprob": -0.11520026711856618, "compression_ratio": 1.5719557195571956, "no_speech_prob": 0.005739470478147268}, {"id": 104, "seek": 31196, "start": 311.96, "end": 315.56, "text": " but planetary preservation and interplanetary exploration", "tokens": [50363, 475, 27047, 22459, 290, 987, 11578, 8527, 13936, 50543], "temperature": 0.0, "avg_logprob": -0.14532699584960937, "compression_ratio": 1.5240641711229947, "no_speech_prob": 0.00425163796171546}, {"id": 105, "seek": 31196, "start": 315.56, "end": 317.52, "text": " can work together.", "tokens": [50543, 460, 670, 1978, 13, 50641], "temperature": 0.0, "avg_logprob": -0.14532699584960937, "compression_ratio": 1.5240641711229947, "no_speech_prob": 0.00425163796171546}, {"id": 106, "seek": 31196, "start": 317.52, "end": 319.56, "text": " If we truly believe in our ability", "tokens": [50641, 1002, 356, 4988, 1975, 287, 674, 2694, 50743], "temperature": 0.0, "avg_logprob": -0.14532699584960937, "compression_ratio": 1.5240641711229947, "no_speech_prob": 0.00425163796171546}, {"id": 107, "seek": 31196, "start": 319.56, "end": 323.15999999999997, "text": " to bend the hostile environments of Mars for human habitation,", "tokens": [50743, 284, 19396, 262, 12524, 12493, 286, 8706, 329, 1692, 7947, 341, 11, 50923], "temperature": 0.0, "avg_logprob": -0.14532699584960937, "compression_ratio": 1.5240641711229947, "no_speech_prob": 0.00425163796171546}, {"id": 108, "seek": 31196, "start": 323.15999999999997, "end": 326.12, "text": " then we should be able to surmount the far easier task", "tokens": [50923, 788, 356, 815, 307, 1498, 284, 969, 14948, 262, 1290, 4577, 4876, 51071], "temperature": 0.0, "avg_logprob": -0.14532699584960937, "compression_ratio": 1.5240641711229947, "no_speech_prob": 0.00425163796171546}, {"id": 109, "seek": 31196, "start": 326.12, "end": 328.71999999999997, "text": " of preserving the habitability of the Earth.", "tokens": [51071, 286, 23934, 262, 7947, 1799, 286, 262, 3668, 13, 51201], "temperature": 0.0, "avg_logprob": -0.14532699584960937, "compression_ratio": 1.5240641711229947, "no_speech_prob": 0.00425163796171546}, {"id": 110, "seek": 31196, "start": 328.71999999999997, "end": 330.0, "text": " Thank you.", "tokens": [51201, 6952, 345, 13, 51265], "temperature": 0.0, "avg_logprob": -0.14532699584960937, "compression_ratio": 1.5240641711229947, "no_speech_prob": 0.00425163796171546}], "language": "English"}